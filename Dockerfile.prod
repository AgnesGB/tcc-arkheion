# Dockerfile para PRODUÇÃO
FROM python:3.12-slim

# Variáveis de ambiente para produção
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=arkheion.settings

# Diretório de trabalho
WORKDIR /app

# Instalar dependências de sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copiar requirements
COPY arkheion/requirements.txt /app/requirements.txt

# Instalar dependências Python + Gunicorn para produção
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install gunicorn psycopg2-binary

# Copiar código da aplicação
COPY arkheion /app

# Criar usuário não-root para segurança
RUN groupadd -r django && useradd -r -g django django && \
    chown -R django:django /app
USER django

# Expor porta
EXPOSE 8000

# Comando para produção com Gunicorn
CMD ["gunicorn", "arkheion.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "30"]